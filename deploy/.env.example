# 复制为 .env 并填入真实值；.env 已被 .gitignore 覆盖（.env / .env.*），严禁提交
# ============ 数据库（RDS MySQL）============
# rm-xxx 为 RDS 内网地址（与 ECS 同 VPC 时用内网域名，不走公网流量计费）
DB_URL=jdbc:mysql://rm-xxxxxxxxxxxx.mysql.rds.aliyuncs.com:3306/finflow?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=finflow_app
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ============ 认证 ============
# 生成方式（在任意有 openssl 的机器上）：openssl rand -base64 48
JWT_SECRET=CHANGE_ME_RANDOM_64_CHAR_SECRET
JWT_EXPIRATION=2h

# ============ 业务开关（首期上云保持安全默认值）============
PAYMENT_ENABLED=false
CITIC_MOCK_MODE=true
KINGDEE_MOCK_MODE=true
BANKDATA_ADAPTER_MODE=mock
BANKDATA_REAL_ADAPTERS_ENABLED=false
